# Copy to `.env` and fill in what you have. Nothing here is required in full: the roster is
# filtered to the lanes you can actually reach, and `run_evaluators.py` prints which rows it
# dropped and why. See docs/REPRODUCE.md §3 for the lane table.

# --- Fireworks: the open-weight rows, both judges, and all three agent models -------------
# Needed for generation (every model in the pipeline is on Fireworks) and for 11 of the 25
# evaluator rows.
FIREWORKS_API_KEY=

# Only for the three dedicated-deployment evaluator rows (`qwen3-4b`, `qwen3-1p7b`,
# `gemma-4-31b`) and for the pipeline's own dedicated user-simulator and generator
# deployments. Serverless rows do not use it. Without it those three rows are skipped.
FIREWORKS_ACCOUNT_ID=

# --- Google -------------------------------------------------------------------------------
# Either name works; GEMINI_API_KEY is checked first.
GEMINI_API_KEY=
GOOGLE_API_KEY=

# --- Vendor-direct lanes ------------------------------------------------------------------
# Used when the gateway below is unset. This is the reproducible route for the Claude and
# GPT rows, but it is NOT what produced the published numbers -- treat a direct-route rerun
# as a replication, not as a check of arithmetic.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- The gateway ---------------------------------------------------------------------------
# Twelve of the 25 published rows -- every Claude, every GPT, all three Llamas, Mistral -- came
# through one OpenAI-compatible gateway in front of several vendors. It is a site-specific
# deployment rather than a public endpoint, so reproducing it call-for-call needs an
# equivalent of your own; leave these unset and the Claude and GPT rows reroute to the vendor
# keys above, while the four gateway-only open-weight rows are dropped rather than guessed.
GATEWAY_BASE_URL=
GATEWAY_API_KEY=

# Optional. Some gateways attribute usage to a header rather than to the credential. Both
# the name and the value are per-installation; the header defaults to `X-Gateway-User` and
# is sent only when a user is set.
GATEWAY_USER=
GATEWAY_USER_HEADER=
